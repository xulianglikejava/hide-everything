<Window x:Class="HideIt.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource MainWindow_Title}"
        Width="720" Height="480"
        WindowStartupLocation="CenterScreen"
        MinWidth="560" MinHeight="320">
    <DockPanel Margin="12">

        <!-- Top toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{DynamicResource Main_AddApp}" Padding="12,5" Command="{Binding AddAppCommand}" />
            <Button Content="{DynamicResource Main_AddWindowRule}" Padding="12,5" Margin="8,0,0,0" Command="{Binding AddWindowRuleCommand}" />
            <Button Content="{DynamicResource Main_HideWindow}" Padding="12,5" Margin="8,0,0,0" Command="{Binding HideWindowCommand}" />
            <Button Content="{DynamicResource Main_RestoreAll}" Padding="12,5" Margin="8,0,0,0" Command="{Binding RestoreAllCommand}" />
        </StackPanel>

        <!-- Bottom bar -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource Main_PanicHotKey}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding PanicHotKeyText}"
                           VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="110" Margin="8,0" />
                <Button Grid.Column="2" Content="{DynamicResource Main_Set}" Padding="8,2"
                        Command="{Binding SetPanicHotKeyCommand}" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource Main_ShowLastHotKey}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ShowLastHotKeyText}"
                           VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="110" Margin="8,0" />
                <Button Grid.Column="2" Content="{DynamicResource Main_Set}" Padding="8,2"
                        Command="{Binding SetShowLastHotKeyCommand}" />
                <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                           Text="{DynamicResource Main_ShowLastHelp}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{DynamicResource Main_Shortcuts}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="{DynamicResource Main_AddDesktop}" Padding="10,3" Command="{Binding AddDesktopShortcutCommand}" />
                <Button Content="{DynamicResource Main_AddStartMenu}" Padding="10,3" Margin="8,0,0,0" Command="{Binding AddStartMenuShortcutCommand}" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 动态匹配提示仅说明等待状态，不作为错误弹窗或红色告警。 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#FFB00000"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DynamicStatusMessage}"
                               Foreground="Gray"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="{DynamicResource Main_Startup}"
                              VerticalAlignment="Center"
                              IsChecked="{Binding RunAtStartup, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{DynamicResource Language_Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="116"
                              SelectedValue="{Binding Language, Mode=TwoWay}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Tag="zh-CN" Content="{DynamicResource Language_Chinese}" />
                        <ComboBoxItem Tag="en-US" Content="{DynamicResource Language_English}" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- 程序规则和窗口规则共用列表区域，窗口规则单独展示以避免混淆两种控制范围。 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Main_AppsSection}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <DataGrid Grid.Row="1" x:Name="Grid"
                          ItemsSource="{Binding Apps}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="40"
                          SelectionMode="Single">
                    <DataGrid.Columns>

                <DataGridTemplateColumn Header="" Width="44" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Icon}" Width="24" Height="24" Margin="6,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True" />

                <DataGridTemplateColumn Header="" Width="64" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip="{DynamicResource Main_EnableAppTooltip}"
                                      Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="" Width="220" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ShortcutText}"
                                           VerticalAlignment="Center"
                                           MinWidth="110"
                                           Margin="6,0" />
                                <Button Content="{DynamicResource Main_Set}"
                                        Padding="8,2"
                                        Command="{Binding DataContext.SetHotKeyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="" Width="80" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{DynamicResource Main_Delete}"
                                    Padding="8,2"
                                    Margin="4,0"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Main_WindowRulesSection}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <DataGrid Grid.Row="1"
                          x:Name="WindowRulesGrid"
                          ItemsSource="{Binding WindowRules}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="40"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="44" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon}" Width="24" Height="24" Margin="6,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="" Binding="{Binding MatchDescription}" Width="260" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="" Width="64" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ToolTip="{DynamicResource Main_EnableWindowTooltip}"
                                              Command="{Binding DataContext.ToggleWindowRuleEnabledCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="220" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ShortcutText}" VerticalAlignment="Center" MinWidth="110" Margin="6,0" />
                                        <Button Content="{DynamicResource Main_Set}" Padding="8,2"
                                                Command="{Binding DataContext.SetWindowRuleHotKeyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="80" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{DynamicResource Main_Delete}" Padding="8,2" Margin="4,0"
                                            Command="{Binding DataContext.RemoveWindowRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
