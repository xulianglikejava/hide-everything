<Window x:Class="HideIt.Views.HideWindowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource HideWindow_Title}"
        Width="520" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="{DynamicResource HideWindow_Instruction}" />

        <ListBox Grid.Row="1" x:Name="List" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="2">
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                            <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                <TextBlock Text="{Binding ProcessName}" Foreground="Gray" FontSize="11" />
                            </StackPanel>
                            <Border Visibility="{Binding HasShortcut, Converter={StaticResource BoolToVis}}"
                                    Background="#E3F2FD" CornerRadius="3" Padding="6,1"
                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                    ToolTip="{DynamicResource HideWindow_ExistingShortcutTooltip}">
                                <TextBlock Text="{Binding Shortcut}" FontSize="11" Foreground="#1565C0" />
                            </Border>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2" Content="{DynamicResource HideWindow_Refresh}" HorizontalAlignment="Left"
                Margin="0,8,0,0" Padding="10,4" Click="Refresh_Click" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource HideWindow_Assign}" Width="130" Margin="0,0,8,0" Click="Assign_Click" />
            <Button Content="{DynamicResource HideWindow_HideSelected}" Width="120" Margin="0,0,8,0" IsDefault="True" Click="Hide_Click" />
            <Button Content="{DynamicResource HideWindow_Cancel}" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
